<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="@typeof(AMWatch.Presentation.Layouts.MainLayout)" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(AMWatch.Presentation.Layouts.MainLayout)">
                <p>Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
